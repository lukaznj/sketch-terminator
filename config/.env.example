# Copy this file to config/.env and fill in your key.
# config/.env is gitignored; never commit a real key.

OPENAI_API_KEY=your_openai_api_key_here

# Model used by the ROSA agent.
LLM_MODEL=gpt-5-mini

# 0.0 keeps tool calls deterministic, which is what you want when the
# output moves a physical arm.
LLM_TEMPERATURE=0.0
